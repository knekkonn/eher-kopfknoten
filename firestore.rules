rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/profile/rotation {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['round','order','last'])
        && request.resource.data.round is int && request.resource.data.round >= 0
        && request.resource.data.order is list && request.resource.data.order.size() <= 2000
        && request.resource.data.last is map && request.resource.data.last.keys().size() <= 2000;
      allow delete: if false;
    }
    match /users/{userId}/profile/{profileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && profileId == 'preferences'
        && request.resource.data.keys().hasOnly(['skin','seenUpdate'])
        && request.resource.data.skin is string && request.resource.data.skin.size() <= 32
        && request.resource.data.seenUpdate is string && request.resource.data.seenUpdate.size() <= 32;
      allow delete: if false;
    }
    match /rejectedAnswers/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','question','answer','createdAt','status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.question is string && request.resource.data.question.size() <= 250
        && request.resource.data.answer is string && request.resource.data.answer.size() <= 180
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /users/{userId}/games/{gameId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validGame() {
        return request.resource.data.keys().hasOnly(['score', 'day'])
          && request.resource.data.keys().hasAll(['score'])
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 700
          && (!('day' in request.resource.data) || (request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }
      allow read: if owner();
      allow create: if owner() && validGame();
      // Repeating an upload is safe, but a stored result cannot be changed.
      allow update: if owner() && validGame() && request.resource.data == resource.data;
      allow delete: if false;
    }
  }
}
